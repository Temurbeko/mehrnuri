# =============================================================================
#  MehrNuri — Environment Configuration
# =============================================================================

NEXT_PUBLIC_BRAND_NAME=MehrNuri
NEXT_PUBLIC_BRAND_LOGO=/brand/logo.jpg

APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mehrnuri

RESERVATION_MINUTES=20
MIN_DONATION_UZS=1000
MAX_DONATION_UZS=10000000

RATE_LIMIT_STORE=mongo

# live = verify receipts with Soliq (server must be inside Uzbekistan)
# mock = test hosting only (e.g. Netlify): any well-formed ofd.soliq.uz link is accepted
SOLIQ_MODE=live

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
